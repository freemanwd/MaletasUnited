# Public URL of this Vercel deployment (Open Graph / metadataBase).
# Example: https://maletas-play.vercel.app
NEXT_PUBLIC_PLAY_URL=

# --- Not used in this preview. Required later; see ARCHITECTURE.md. ---

# Clerk (auth + roles player | host | admin)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe Billing (Maletas VIP $1.99/mo or $20/yr) + Connect (optional merch)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_VIP_MONTHLY_PRICE_ID=
# STRIPE_VIP_YEARLY_PRICE_ID=
# STRIPE_CONNECT_CLIENT_ID=

# Listings ingest (later)
# GOOGLE_PLACES_API_KEY=

# Vercel Postgres / Neon via Prisma or Drizzle
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Maps / geocoding (replace ZIP-prefix search)
# MAPS_API_KEY=

# Notifications (email / push). Pick a provider when that step starts.
# RESEND_API_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
